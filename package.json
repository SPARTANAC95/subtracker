{
  "name": "subtracker",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server.mjs --open",
    "app": "npm run build && node server.mjs --open",
    "lint": "eslint .",
    "test": "node --test tests/domain.test.mjs tests/sync.test.mjs tests/server.test.mjs",
    "check": "npm run lint && npm test && npm run build",
    "preview": "vite preview",
    "serve": "node server.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "tailwindcss": "^4.1.18",
